#  server port
PGHOST=localhost

##DATABASE
# database user
PGUSER=cowapp
# user password
PGPASSWORD=cowapp
# database name to connect
PGDATABASE=cowapp
# database port
PGPORT=5432
# "true" only for a hosted/managed Postgres that requires SSL (Render, Supabase, Neon...).
# Leave "false" for local/Docker Postgres.
PGSSL=false

# AUTHORIZATION CONFIG (use openssl rand -hex 32)
JWT_SECRET=

# DOCKER COMPOSE DATABASE CREATION (OPTIONAL, CAN BE SKIPPED)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
